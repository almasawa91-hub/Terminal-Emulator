<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:orientation="vertical" android:padding="8dp">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTerminal" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/editTextCommand" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:background="#171717" android:hint="أدخل الأمر هنا..."
            android:imeOptions="actionDone" android:inputType="textNoSuggestions"
            android:maxLines="4" android:padding="10dp" android:textColor="#FFFFFF"
            android:textColorHint="#888888" android:typeface="monospace" />
        <Button android:id="@+id/btnExecute" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="تنفيذ" />
    </LinearLayout>
</LinearLayout>
